{
  "name": "honeybadger",
  "version": "0.3.0",
  "description": "Set up Honeybadger, debug errors, investigate incidents from logs, create alarms, and monitor cron jobs, with live account access via the Honeybadger MCP server.",
  "userConfig": {
    "mcp_url": {
      "type": "string",
      "title": "Honeybadger MCP server",
      "description": "https://mcp.honeybadger.io/mcp for US accounts (app.honeybadger.io), https://eu-mcp.honeybadger.io/mcp for EU accounts (eu-app.honeybadger.io)",
      "default": "https://mcp.honeybadger.io/mcp",
      "options": ["https://mcp.honeybadger.io/mcp", "https://eu-mcp.honeybadger.io/mcp"]
    }
  },
  "mcpServers": {
    "honeybadger": {
      "type": "http",
      "url": "${user_config.mcp_url}"
    }
  },
  "author": {
    "name": "Honeybadger Industries LLC",
    "email": "support@honeybadger.io",
    "url": "https://www.honeybadger.io"
  },
  "homepage": "https://www.honeybadger.io",
  "repository": "https://github.com/honeybadger-io/skills",
  "license": "MIT",
  "icon": "./.claude-plugin/icon.png",
  "documentationUrl": "https://docs.honeybadger.io/resources/mcp/",
  "supportUrl": "https://www.honeybadger.io/contact/",
  "privacyPolicyUrl": "https://www.honeybadger.io/privacy/",
  "termsOfServiceUrl": "https://www.honeybadger.io/terms/",
  "keywords": ["honeybadger", "error-tracking", "debugging", "monitoring", "observability", "logging", "alarms", "mcp"]
}
