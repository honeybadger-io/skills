      },
      "grid": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "config": {
        "streams": [
          "default"
        ],
        "query": "filter event_type::str == \"process_action.action_controller\"\n| stats avg(duration::float) as avg by controller::str, action::str\n| sort avg desc\n| limit 10\n| only controller as Controller, action as Action, toHumanString(avg, \"milliseconds\") as `Avg`",
        "vis": {
          "view": "table"
        }
      }
    },
