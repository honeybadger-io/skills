          "view": "line",
          "chart_config": {
            "xField": "time",
            "yField": "count"
          }
        }
      }
    },
    {
      "id": "8b2d4e6f-1a3c-4d5e-8f7a-2b4c6d8e0a43",
      "type": "insights_vis",
      "presentation": {
        "title": "Server errors",
        "subtitle": "Responses with status 500 or above"
      },
      "grid": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "config": {
        "streams": [
          "default"
        ],
        "query": "filter event_type::str == \"process_action.action_controller\" and status::int >= 500\n| stats count() as count",
        "vis": {
          "view": "billboard",
          "chart_config": {
            "valueField": "count"
          }
        }
      }
    },
    {
